<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>DoriathMod</AssemblyName>
    <RootNamespace>DoriathMod</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>10</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <!-- ── Exclusion du dossier "Claude outputs" (archive de référence livrée par Claude,
       pas du code à compiler) ─────────────────────────────────────────────────────
       Un projet SDK-style compile par défaut TOUS les .cs sous le dossier du projet.
       Si ce dossier (ou tout autre contenant une copie de sources, ex: un paquet de
       connaissances dézippé ici) se retrouve sous VsCodeProject, ses .cs entrent en
       conflit CS0101/CS0111 avec les vraies sources. On l'exclut explicitement pour
       que ce cas ne casse plus jamais le build, quel que soit ce qui y est déposé. -->
  <ItemGroup>
    <Compile Remove="Claude outputs\**\*.cs" />
    <None Remove="Claude outputs\**\*.cs" />
    <EmbeddedResource Remove="Claude outputs\**\*.cs" />
  </ItemGroup>

  <!-- ── Chemins hardcodés vers Demeo (Oculus) ──────────────────────── -->
  <PropertyGroup>
    <DemeoBase>C:\Program Files\Oculus\Software\Software\resolution-games-demeo\demeorift_release</DemeoBase>
    <BepInExDir>$(DemeoBase)\BepInEx</BepInExDir>
    <DemeoManagedDir>$(DemeoBase)\Demeo_Data\Managed</DemeoManagedDir>
  </PropertyGroup>

  <!-- ── BepInEx core ──────────────────────────────────────────────── -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Harmony">
      <HintPath>$(BepInExDir)\core\BepInEx.Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ── HouseRules — utilise les .BIE.dll qui contiennent les bons namespaces -->
  <ItemGroup>
    <Reference Include="HouseRules.Core.BIE">
      <HintPath>$(BepInExDir)\plugins\HouseRules.Core.BIE.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HouseRules.Core">
      <HintPath>$(BepInExDir)\plugins\HouseRules.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HouseRules.Essentials.BIE">
      <HintPath>$(BepInExDir)\plugins\HouseRules.Essentials.BIE.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HouseRules.Essentials">
      <HintPath>$(BepInExDir)\plugins\HouseRules.Essentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HouseRules.Configuration.BIE">
      <HintPath>$(BepInExDir)\plugins\HouseRules.Configuration.BIE.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ── DemeoMods.Common.UI — extraite de la ressource Costura embarquée dans
       HouseRules.Configuration.BIE.dll (VrResourceTable / VrElementCreator, utilisés
       par DoriathPerksPanel.cs). Private=false : au runtime, le loader de Costura déjà
       enregistré par HouseRules.Configuration.BIE.dll doit résoudre ce type via
       l'AssemblyResolve de l'AppDomain, donc on ne l'embarque pas nous-mêmes. -->
  <ItemGroup>
    <Reference Include="DemeoMods.Common.UI">
      <HintPath>$(ProjectDir)Libs\DemeoMods.Common.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ── DLLs du jeu Demeo ─────────────────────────────────────────── -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(DemeoManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(DemeoManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(DemeoManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(DemeoManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ── Copie automatique DLL + JSON après build ─────────────────── -->
  <Target Name="DeployPlugin" AfterTargets="Build"
          Condition="Exists('$(BepInExDir)\plugins')">
    <Message Text="Déploiement de ProgressiveMod.dll dans $(BepInExDir)\plugins" Importance="high"/>
    <Copy
      SourceFiles="$(OutputPath)$(AssemblyName).dll"
      DestinationFolder="$(BepInExDir)\plugins"
      SkipUnchangedFiles="false"
    />
    <Message Text="Déploiement de Doriath (PROGRESSIVE).json dans $(DemeoBase)\HouseRules" Importance="high"/>
    <Copy
      SourceFiles="$(ProjectDir)Doriath (PROGRESSIVE).json"
      DestinationFolder="$(DemeoBase)\HouseRules"
      SkipUnchangedFiles="false"
    />
  </Target>

</Project>
